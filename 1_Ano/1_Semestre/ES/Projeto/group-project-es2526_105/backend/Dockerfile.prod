FROM maven:3.9.8-eclipse-temurin-21-alpine AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

FROM eclipse-temurin:21-jre-alpine

# OCI labels to link package to repository (required for GHCR)
LABEL org.opencontainers.image.source="https://github.com/detiuaveiro/group-project-es2526_105"
LABEL org.opencontainers.image.description="RTMP Backend - Spring Boot REST API"
LABEL org.opencontainers.image.licenses="MIT"

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# Create logs directory with proper permissions
RUN mkdir -p /logs && chown -R appuser:appgroup /logs

VOLUME /app
COPY --from=build /app/target/*.jar app.jar
COPY --from=build /app/target/opentelemetry-javaagent.jar otel-agent.jar

# Change ownership of the jar files
RUN chown appuser:appgroup app.jar otel-agent.jar

# Switch to non-root user
USER appuser

# JVM optimization for production with OpenTelemetry agent
ENTRYPOINT ["java", \
    "-javaagent:/otel-agent.jar", \
    "-XX:+UseContainerSupport", \
    "-XX:MaxRAMPercentage=70.0", \
    "-XX:+UseG1GC", \
    "-XX:+UseStringDeduplication", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "-jar", "/app.jar"]
