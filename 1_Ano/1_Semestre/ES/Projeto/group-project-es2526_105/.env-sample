# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=db
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Reddis Configuration
REDIS_HOST=redis

# Application Ports
FRONTEND_PORT=8090
BACKEND_PORT=8095
PGADMIN_PORT=8096
KEYCLOAK_PORT=8097
FLAGSMITH_PORT=8098
REDIS_PORT=6379

# Application URLs (localhost for local dev, CD workflow overrides for production)
FRONTEND_URL=http://localhost:8090
BACKEND_URL=http://localhost:8095
FLAGSMITH_URL=http://localhost:8098
KEYCLOAK_URL=http://localhost:8097

# CORS Configuration (localhost for local dev, CD workflow overrides for production)
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=localhost
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_CLIENT_ID=rtmp-client
KEYCLOAK_ISSUER_URI=http://localhost:8097/realms/rtmp
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/rtmp/protocol/openid-connect/certs
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=rtmp

# Flagsmith Configuration
FLAGSMITH_ENVIRONMENT_KEY=your-flagsmith-environment-key
FLAGSMITH_API_URL=http://flagsmith:8000/api/v1/

# E2E Test Configuration
E2E_BASE_URL=http://localhost:8090
E2E_API_URL=http://localhost:8095
E2E_KEYCLOAK_URL=http://localhost:8097

# Nginx Configuration
NGINX_SERVER_NAME=deti-engsoft-05.ua.pt

# Google AI Gemini Configuration
GOOGLE_AI_GEMINI_API_KEY=your-google-ai-gemini-api-key
GOOGLE_AI_GEMINI_MODEL_NAME=gemini-2.5-flash