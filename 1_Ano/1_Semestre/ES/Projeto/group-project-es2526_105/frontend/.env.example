# Frontend environment configuration
# Create a .env.local file (which is gitignored) to override these values

# Backend API URL - change this to point to your backend server
VITE_BACKEND_URL=http://localhost:8095

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8097
VITE_KEYCLOAK_REALM=rtmp
VITE_KEYCLOAK_CLIENT_ID=rtmp-client

# Flagsmith Configuration
VITE_FLAGSMITH_API_URL=http://localhost:8098/api/v1/
VITE_FLAGSMITH_ENVIRONMENT_KEY=your-flagsmith-environment-key