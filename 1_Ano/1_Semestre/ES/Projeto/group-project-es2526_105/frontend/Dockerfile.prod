FROM node:24 AS builder

WORKDIR /usr/app

# Declare build arguments for environment variables
ARG VITE_BACKEND_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_FLAGSMITH_API_URL
ARG VITE_FLAGSMITH_ENVIRONMENT_KEY

# Set environment variables from build args
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}
ENV VITE_FLAGSMITH_API_URL=${VITE_FLAGSMITH_API_URL}
ENV VITE_FLAGSMITH_ENVIRONMENT_KEY=${VITE_FLAGSMITH_ENVIRONMENT_KEY}

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# OCI labels to link package to repository (required for GHCR)
LABEL org.opencontainers.image.source="https://github.com/detiuaveiro/group-project-es2526_105"
LABEL org.opencontainers.image.description="RTMP Frontend - React application"
LABEL org.opencontainers.image.licenses="MIT"

# Copy built files from builder stage
COPY --from=builder /usr/app/dist /usr/share/nginx/html

# Copy nginx configuration if needed
# COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]